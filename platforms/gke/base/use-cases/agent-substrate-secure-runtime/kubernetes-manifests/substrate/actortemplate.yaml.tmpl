# Agent Substrate ActorTemplate (protojson-shaped ateapi.ActorTemplate) applied
# via `kubectl-ate create actor-template -f -`.
# Creating this ActorTemplate triggers an automatic Golden Snapshot build job on
# a warm WorkerPool pod: it boots the container, pre-loads numpy/scipy/pandas/
# matplotlib into memory, waits for /readyz on port 80, and checkpoints memory +
# filesystem state (`SNAPSHOT_FIDELITY_MEMORY`) as the Golden Snapshot.
metadata:
  atespace: ${SUBSTRATE_ATESPACE}
  name: scientific-python
workerSelector:
  matchLabels:
    workload: scientific-python
containers:
  - name: runner
    image: ${RUNNER_IMAGE}
    command: ["/usr/local/bin/python", "/usr/src/app/runner.py"]
    env:
      - name: PORT
        value: "80"
      - name: SSL_CERT_DIR
        value: /run/ate/egress-trust-bundle/
      - name: SSL_CERT_FILE
        value: /run/ate/egress-trust-bundle/trust-bundle.pem
      - name: REQUESTS_CA_BUNDLE
        value: /run/ate/egress-trust-bundle/trust-bundle.pem
    volumeMounts:
      - name: system-info
        mountPath: /run/ate
    wakeupProbe:
      httpGet:
        path: /readyz
        port: 80
volumes:
  - name: system-info
    systemInfo:
      dataSources:
        - trustBundle:
            names:
              - egress-mitm.ate.dev
              - system-roots.ate.dev
            path: egress-trust-bundle/trust-bundle.pem
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
# Snapshots are stored under ate-api-server's --snapshot-location
# (gs://<snapshot bucket>/). Per-template storageLocation requires the
# PerTemplateSnapshotLocation preview gate as of Agent Substrate v1.0.0.
