# Out-of-sandbox credential storage in the dedicated `agent-credentials`
# namespace. The actor sandbox never mounts this Secret or receives the token in
# its environment or memory snapshot; instead, `atenet-egress` resolves the
# `ate-secret://k8s.io/default/agent-credentials/github-readonly-token/token`
# URI via `k8s-credential-provider` at the gateway boundary.
apiVersion: v1
kind: Namespace
metadata:
  name: agent-credentials
---
apiVersion: v1
kind: Secret
metadata:
  name: github-readonly-token
  namespace: agent-credentials
type: Opaque
stringData:
  token: "${GITHUB_READONLY_TOKEN}"
