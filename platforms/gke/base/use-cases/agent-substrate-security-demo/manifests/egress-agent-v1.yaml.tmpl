# ActorTemplate egress-agent-v1: zero-build Python HTTP fetch actor with egress MITM trust bundle.
metadata:
  atespace: ${ATESPACE}
  name: egress-agent-v1
workerSelector:
  matchLabels:
    workload: workshop-agent
containers:
- name: agent-fetch
  image: registry.k8s.io/agent-sandbox/python-runtime-sandbox:v0.5.6@sha256:147a6a7f3b382683a065e4519b22088e75472317ce861d57031537a758836ab5
  command:
  - python3
  - -c
  - |
    import urllib.request
    from fastapi import FastAPI, Query
    from fastapi.responses import PlainTextResponse
    import uvicorn

    app = FastAPI()

    @app.get("/readyz")
    def readyz():
        return PlainTextResponse("ok\n")

    @app.get("/fetch")
    def fetch(url: str = Query(...)):
        try:
            req = urllib.request.Request(
                url,
                headers={"Authorization": "Bearer placeholder", "User-Agent": "Go-http-client/2.0"},
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                return PlainTextResponse(resp.read().decode("utf-8", errors="replace"), status_code=resp.status)
        except Exception as exc:
            return PlainTextResponse(f"fetch: Get \"{url}\": {exc}\n", status_code=502)

    uvicorn.run(app, host="0.0.0.0", port=80)
  env:
  - name: SSL_CERT_FILE
    value: /run/ate/trust-bundle.pem
  - name: SSL_CERT_DIR
    value: /dev/null
  wakeupProbe:
    httpGet: {path: /readyz, port: 80}
  volumeMounts:
  - {name: system-info, mountPath: /run/ate}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        path: trust-bundle.pem
        names: ["egress-mitm.ate.dev", "system-roots.ate.dev"]
