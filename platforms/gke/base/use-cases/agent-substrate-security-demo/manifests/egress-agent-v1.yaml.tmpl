# ActorTemplate egress-agent-v1: Zero-secret HTTP fetch actor with egress MITM trust bundle.
# Runs `/app-src/egress_agent.py` from the immutable `@sha256` container image built from ../app/Dockerfile.
metadata:
  atespace: ${ATESPACE}
  name: egress-agent-v1
workerSelector:
  matchLabels:
    workload: workshop-agent
containers:
- name: agent-fetch
  image: ${AGENT_IMAGE}
  command: ["python3", "/app-src/egress_agent.py"]
  env:
  - name: SSL_CERT_FILE
    value: /run/ate/trust-bundle.pem
  - name: SSL_CERT_DIR
    value: /dev/null
  wakeupProbe:
    httpGet: {path: /readyz, port: 80}
  volumeMounts:
  - {name: system-info, mountPath: /run/ate}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        path: trust-bundle.pem
        names: ["egress-mitm.ate.dev", "system-roots.ate.dev"]
