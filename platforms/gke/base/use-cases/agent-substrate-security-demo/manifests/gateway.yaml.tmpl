# Split-plane Python Gateway Deployment using GKE Workload Identity -> Vertex AI / Gemini.
# Python source lives in ../app/gateway.py:
# - Default customer demo mode: mounted from ConfigMap/gateway-app at /app-src/gateway.py.
# - Production mode (APP_IMAGE set): baked into immutable @sha256 image from ../app/Dockerfile.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gateway
  namespace: ${NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  replicas: 1
  selector:
    matchLabels: {app: gateway}
  template:
    metadata:
      labels: {app: gateway}
      annotations:
        checksum/gateway-py: "${GATEWAY_CODE_SHA}"
    spec:
      serviceAccountName: gateway
      containers:
      - name: gateway
        image: ${GATEWAY_IMAGE}
        command: ["python3", "/app-src/gateway.py"]
        ports:
        - {name: http, containerPort: 8080}
        - {name: admin, containerPort: 8081}
        env:
        - {name: ATESPACE, value: "${ATESPACE}"}
        - {name: GEMINI_MODEL, value: "${GEMINI_MODEL}"}
        - {name: GOOGLE_CLOUD_PROJECT, value: "${PROJECT_ID}"}
        - {name: GOOGLE_CLOUD_LOCATION, value: "global"}
        readinessProbe:
          httpGet: {path: /readyz, port: admin}
        resources:
          requests: {cpu: 100m, memory: 128Mi}
          limits: {memory: 256Mi}
        volumeMounts: ${GATEWAY_VOLUME_MOUNTS_JSON}
      volumes: ${GATEWAY_VOLUMES_JSON}
---
apiVersion: v1
kind: Service
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  selector: {app: gateway}
  ports:
  - {name: http, port: 80, targetPort: http}
  - {name: admin, port: 8081, targetPort: admin}
