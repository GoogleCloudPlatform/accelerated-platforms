# Split-plane Python Gateway Deployment:
# - Calls `atenet-router:443` over native SPIFFE mTLS (`podCertificate` + `clusterTrustBundle`).
# - Restricts `:8080` (model proxy) via NetworkPolicy to `atenet-egress` and Managed Prometheus.
# - Binds `:8081` (operator API) to `127.0.0.1` loopback inside the pod and requires `Secret/gateway-admin-token`.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gateway
  namespace: ${NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  replicas: 1
  selector:
    matchLabels: {app: gateway}
  template:
    metadata:
      labels: {app: gateway}
      annotations:
        checksum/app-image: "${GATEWAY_CODE_SHA}"
    spec:
      serviceAccountName: gateway
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: gateway
        image: ${GATEWAY_IMAGE}
        command: ["python3", "/app-src/gateway.py"]
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
        ports:
        - {name: http, containerPort: 8080}
        env:
        - {name: ATESPACE, value: "${ATESPACE}"}
        - {name: GEMINI_MODEL, value: "${GEMINI_MODEL}"}
        - {name: GOOGLE_CLOUD_PROJECT, value: "${PROJECT_ID}"}
        - {name: GOOGLE_CLOUD_LOCATION, value: "global"}
        - {name: ADMIN_BIND_HOST, value: "127.0.0.1"}
        - name: GATEWAY_ADMIN_TOKEN
          valueFrom:
            secretKeyRef:
              name: gateway-admin-token
              key: token
        readinessProbe:
          httpGet: {path: /readyz, port: http}
        livenessProbe:
          httpGet: {path: /readyz, port: http}
        resources:
          requests: {cpu: 100m, memory: 128Mi}
          limits: {memory: 512Mi}
        volumeMounts:
        - name: router-client
          mountPath: /run/router-client
          readOnly: true
        - name: tmp
          mountPath: /tmp
      volumes:
      - name: router-client
        projected:
          defaultMode: 420
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: router-ca.pem
      - name: tmp
        emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  selector: {app: gateway}
  ports:
  - {name: http, port: 80, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: gateway-isolation
  namespace: ${NAMESPACE}
spec:
  podSelector:
    matchLabels:
      app: gateway
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: ate-system
      podSelector:
        matchLabels:
          app: atenet-egress
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: gmp-system
    ports:
    - protocol: TCP
      port: 8080
