# ActorTemplate gemini-agent-v1: Stateful Google ADK (`google-adk`) actor inside gVisor.
# Runs `/app-src/gemini_agent.py` from the immutable `@sha256` container image built from
# ../app/Dockerfile with zero Google Cloud credentials inside the sandbox.
metadata:
  atespace: "${ATESPACE}"
  name: gemini-agent-v1
workerSelector:
  matchLabels:
    workload: substrate-agent
containers:
- name: agent
  image: "${AGENT_IMAGE}"
  command: ["python3", "/app-src/gemini_agent.py"]
  env:
  - name: GATEWAY_URL
    value: "http://gateway.${NAMESPACE}.svc.cluster.local"
  - name: GEMINI_MODEL
    value: "${GEMINI_MODEL}"
  wakeupProbe:
    httpGet: {path: /readyz, port: 80}
  volumeMounts:
  - {name: data, mountPath: /data}
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
