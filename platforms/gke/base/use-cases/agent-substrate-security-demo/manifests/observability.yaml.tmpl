# Google Cloud Managed Service for Prometheus (GMP) PodMonitoring + Prometheus UI frontend (:9090).
apiVersion: monitoring.googleapis.com/v1
kind: PodMonitoring
metadata:
  name: gateway
  namespace: ${NAMESPACE}
spec:
  selector:
    matchLabels: {app: gateway}
  endpoints:
  - port: http
    path: /metrics
    interval: 15s
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: prometheus-ui
  namespace: ${NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prometheus-ui
  namespace: ${NAMESPACE}
spec:
  replicas: 1
  selector:
    matchLabels: {app: prometheus-ui}
  template:
    metadata:
      labels: {app: prometheus-ui}
    spec:
      serviceAccountName: prometheus-ui
      nodeSelector: {kubernetes.io/os: linux, kubernetes.io/arch: amd64}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: frontend
        image: gke.gcr.io/prometheus-engine/frontend:v0.15.3-gke.0@sha256:615ba6fcb89717b7346de2746e18fd6d31979cf89eb7b3583c7cea05be827664
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
        args:
        - --web.listen-address=127.0.0.1:9090
        - --query.project-id=${PROJECT_ID}
        ports:
        - {name: web, containerPort: 9090}
        resources:
          requests: {cpu: 50m, memory: 64Mi}
          limits: {memory: 256Mi}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: prometheus-ui-isolation
  namespace: ${NAMESPACE}
spec:
  podSelector:
    matchLabels:
      app: prometheus-ui
  policyTypes:
  - Ingress
  ingress: []
