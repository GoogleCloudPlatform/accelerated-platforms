# Cluster-local non-reflecting credential verification service in ${SECRETS_NAMESPACE}.
# Admits ingress exclusively from `atenet-egress` (`ns/ate-system`), enforces default-deny
# egress, and returns only a boolean authentication status + SHA-256 prefix (never echoing
# the raw credential).
apiVersion: v1
kind: Namespace
metadata:
  name: ${SECRETS_NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: partner-api
  namespace: ${SECRETS_NAMESPACE}
  labels: {app: partner-api}
spec:
  replicas: 1
  selector:
    matchLabels: {app: partner-api}
  template:
    metadata:
      labels: {app: partner-api}
      annotations:
        checksum/app-image: "${GATEWAY_CODE_SHA}"
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: partner-api
        image: ${GATEWAY_IMAGE}
        command: ["python3", "/app-src/partner_api.py"]
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]
        ports:
        - {name: http, containerPort: 8080}
        env:
        - name: EXPECTED_API_TOKEN
          valueFrom:
            secretKeyRef:
              name: example-api
              key: token
        readinessProbe:
          httpGet: {path: /readyz, port: http}
        livenessProbe:
          httpGet: {path: /readyz, port: http}
        resources:
          requests: {cpu: 25m, memory: 64Mi}
          limits: {memory: 128Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: partner-api
  namespace: ${SECRETS_NAMESPACE}
  labels: {app: partner-api}
spec:
  selector: {app: partner-api}
  ports:
  - {name: http, port: 80, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: partner-api-isolation
  namespace: ${SECRETS_NAMESPACE}
spec:
  podSelector:
    matchLabels:
      app: partner-api
  policyTypes:
  - Ingress
  - Egress
  egress: []
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: ate-system
      podSelector:
        matchLabels:
          app: atenet-egress
    ports:
    - protocol: TCP
      port: 8080
