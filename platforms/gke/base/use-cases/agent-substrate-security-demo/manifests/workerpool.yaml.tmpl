apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
  labels:
    ate.dev/api-access: "true"
---
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: agents
  namespace: ${NAMESPACE}
  labels:
    workload: workshop-agent
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
    configRef:
      name: gvisor-default
  template:
    labels:
      workload: workshop-agent
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        preference:
          matchExpressions:
          - key: workload
            operator: In
            values: ["agent-substrate"]
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
