# One inference-perf client. Rendered by scripts/run-benchmark.sh with
# envsubst. The configuration is mounted from the ConfigMap of the same name.
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${BENCH_JOB_NAME}
  namespace: ${BENCH_NAMESPACE}
  labels:
    app.kubernetes.io/name: inference-perf
    app.kubernetes.io/part-of: llmd-multi-region-bench
    bench.llmd-multi-region/run-id: "${BENCH_RUN_ID}"
    bench.llmd-multi-region/arm: "${BENCH_ARM}"
    bench.llmd-multi-region/workload: "${BENCH_WORKLOAD}"
    bench.llmd-multi-region/client: "${BENCH_CLIENT}"
spec:
  activeDeadlineSeconds: ${BENCH_JOB_TIMEOUT_S}
  backoffLimit: 0
  # Safety net in case the collector doesn't delete the Job.
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: inference-perf
        app.kubernetes.io/part-of: llmd-multi-region-bench
        bench.llmd-multi-region/run-id: "${BENCH_RUN_ID}"
        bench.llmd-multi-region/arm: "${BENCH_ARM}"
        bench.llmd-multi-region/workload: "${BENCH_WORKLOAD}"
        bench.llmd-multi-region/client: "${BENCH_CLIENT}"
    spec:
      serviceAccountName: ${BENCH_SERVICE_ACCOUNT}
      restartPolicy: Never
      nodeSelector: ${BENCH_NODE_SELECTOR}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: inference-perf
          image: ${BENCH_IMAGE}
          imagePullPolicy: IfNotPresent
          workingDir: /workspace
          command:
            - python
            - inference_perf/main.py
            - --config_file
            - /config/config.yaml
            - --log-level
            - INFO
          env:
            - name: HOME
              value: /cache
            - name: HF_HOME
              value: /cache/huggingface
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            - name: PYTHONUNBUFFERED
              value: "1"
          resources:
            requests:
              cpu: "${BENCH_CPU}"
              memory: ${BENCH_MEMORY}
            limits:
              cpu: "${BENCH_CPU}"
              memory: ${BENCH_MEMORY}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: config
              mountPath: /config
              readOnly: true
            - name: reports
              mountPath: /reports
            - name: cache
              mountPath: /cache
            - name: tmp
              mountPath: /tmp
            - name: dshm
              mountPath: /dev/shm
      volumes:
        - name: config
          configMap:
            name: ${BENCH_JOB_NAME}
        - name: reports
          emptyDir: {}
        - name: cache
          emptyDir: {}
        - name: tmp
          emptyDir: {}
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: 1Gi
