# Workload `chat` (control): prompts of random vocabulary tokens with no
# deliberate prefix sharing. The `random` generator supports only the
# completion API, which is also what the shared-prefix workload uses.

data:
  type: random
  input_distribution:
    min: ${BENCH_CHAT_INPUT_MIN}
    max: ${BENCH_CHAT_INPUT_MAX}
    mean: ${BENCH_CHAT_INPUT_MEAN}
    std_dev: ${BENCH_CHAT_INPUT_STD_DEV}
    total_count: ${BENCH_CHAT_NUM_PROMPTS}
  output_distribution:
    min: ${BENCH_CHAT_OUTPUT_LEN}
    max: ${BENCH_CHAT_OUTPUT_LEN}
    mean: ${BENCH_CHAT_OUTPUT_LEN}
    std_dev: 0
    total_count: ${BENCH_CHAT_NUM_PROMPTS}
