# Optional (MR_BENCH_GMP=true): collect vLLM server metrics from Google Cloud
# Managed Service for Prometheus. The client authenticates with Application
# Default Credentials (Workload Identity) and needs roles/monitoring.viewer.
# Metrics are aggregated over every model server Pod in the namespace, in
# every region.

metrics:
  type: prometheus
  prometheus:
    google_managed: true
    scrape_interval: ${BENCH_GMP_SCRAPE_INTERVAL_S}
    filters:
      - 'namespace="${BENCH_NAMESPACE}"'
