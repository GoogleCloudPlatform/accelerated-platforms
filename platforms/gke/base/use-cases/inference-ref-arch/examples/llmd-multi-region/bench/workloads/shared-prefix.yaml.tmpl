# Workload `shared-prefix`: num_groups long system prompts, each shared by
# num_prompts_per_group requests with distinct questions. Prompts are shuffled
# across groups with a seeded RNG. Prefix-cache aware routing should win here.

data:
  type: shared_prefix
  shared_prefix:
    num_groups: ${BENCH_SP_NUM_GROUPS}
    num_prompts_per_group: ${BENCH_SP_PROMPTS_PER_GROUP}
    system_prompt_len: ${BENCH_SP_SYSTEM_PROMPT_LEN}
    question_len: ${BENCH_SP_QUESTION_LEN}
    output_len: ${BENCH_SP_OUTPUT_LEN}
    seed: ${BENCH_SEED}
