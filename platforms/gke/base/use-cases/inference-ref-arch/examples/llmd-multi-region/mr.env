# Configuration for the multi-region llm-d + GKE multi-cluster Inference
# Gateway example. Every script in this directory sources this file, so this is
# the single place to change projects, regions, accelerators, models, and
# pinned versions.
#
# Override any value by exporting it before running a script, for example:
#   export MR_PROJECT_ID="my-project"

# ---------------------------------------------------------------------------
# Project and naming
# ---------------------------------------------------------------------------
# Google Cloud project that hosts the fleet, the shared VPC, and every regional
# cluster. Multi-cluster Gateways require every cluster to be in the fleet host
# project and in the same VPC network.
export MR_PROJECT_ID="${MR_PROJECT_ID:-$(gcloud config get-value project 2>/dev/null)}"

# Resource name prefix (1-3 characters), passed to the core platform as
# `resource_name_prefix`.
export MR_RESOURCE_NAME_PREFIX="${MR_RESOURCE_NAME_PREFIX:-inf}"

# Short name (1-6 characters) for this multi-region environment. It is used as
# the prefix of every regional `platform_name`, and to name shared resources.
export MR_ENVIRONMENT_NAME="${MR_ENVIRONMENT_NAME:-mr}"

# Shared VPC network that every regional cluster joins.
export MR_NETWORK_NAME="${MR_NETWORK_NAME:-${MR_RESOURCE_NAME_PREFIX}-${MR_ENVIRONMENT_NAME}-vpc}"

# Kubernetes namespace for the inference workloads. Multi-cluster Services and
# the multi-cluster Inference Gateway match exported resources by namespace and
# name ("namespace sameness"), so it must be identical in every cluster.
export MR_NAMESPACE="${MR_NAMESPACE:-llm-mr}"

# Labels applied to the clusters created by this example, so that they can be
# attributed in shared projects.
export MR_OWNER_LABEL="${MR_OWNER_LABEL:-$(gcloud config get-value account 2>/dev/null | cut -d@ -f1 | tr -c 'a-z0-9_\n-' '-')}"

# ---------------------------------------------------------------------------
# Regions
# ---------------------------------------------------------------------------
# Space-separated list of region keys. Each key needs an entry in every
# MR_REGION_* associative array below. The key becomes the suffix of the
# platform name: platform_name="${MR_ENVIRONMENT_NAME}${key}" (max 9 chars).
export MR_REGION_KEYS="${MR_REGION_KEYS:-usc1 euw2 ase1}"

# The fleet config cluster that hosts the Gateway, HTTPRoute, and policy
# resources. Must be one of MR_REGION_KEYS.
export MR_CONFIG_CLUSTER_KEY="${MR_CONFIG_CLUSTER_KEY:-euw2}"

# Associative arrays can't be exported, so the scripts source this file.
declare -gA MR_REGION=(
  [usc1]="us-central1"
  [euw2]="europe-west2"
  [euw4]="europe-west4"
  [ass2]="asia-south2"
  [ase1]="asia-southeast1"
)

# Node subnet primary range per region. Ranges must not overlap within the VPC.
declare -gA MR_NODE_CIDR=(
  [usc1]="10.10.0.0/20"
  [euw2]="10.20.0.0/20"
  [euw4]="10.30.0.0/20"
  [ass2]="10.40.0.0/20"
  [ase1]="10.50.0.0/20"
)

# REGIONAL_MANAGED_PROXY proxy-only subnet (regional internal ALB, created by
# core/networking).
declare -gA MR_REGIONAL_PROXY_CIDR=(
  [usc1]="10.10.16.0/23"
  [euw2]="10.20.16.0/23"
  [euw4]="10.30.16.0/23"
  [ass2]="10.40.16.0/23"
  [ase1]="10.50.16.0/23"
)

# GLOBAL_MANAGED_PROXY proxy-only subnet (cross-region internal ALB used by the
# multi-cluster Inference Gateway, created by terraform/shared_network).
declare -gA MR_GLOBAL_PROXY_CIDR=(
  [usc1]="10.10.18.0/23"
  [euw2]="10.20.18.0/23"
  [euw4]="10.30.18.0/23"
  [ass2]="10.40.18.0/23"
  [ase1]="10.50.18.0/23"
)

# GKE control plane range per cluster. Must not overlap within the VPC.
declare -gA MR_MASTER_CIDR=(
  [usc1]="172.16.10.0/28"
  [euw2]="172.16.20.0/28"
  [euw4]="172.16.30.0/28"
  [ass2]="172.16.40.0/28"
  [ase1]="172.16.50.0/28"
)

# Machine type of the GKE system node pool per region (core default:
# n4-standard-4). Override a region when that machine type is stocked out, for
# example: MR_SYSTEM_MACHINE_TYPE[usc1]="e2-standard-4". Regions without an
# entry use MR_SYSTEM_MACHINE_TYPE_DEFAULT.
export MR_SYSTEM_MACHINE_TYPE_DEFAULT="${MR_SYSTEM_MACHINE_TYPE_DEFAULT:-n4-standard-4}"
declare -gA MR_SYSTEM_MACHINE_TYPE=(
  # Example override. A stockout of the default machine type in every zone of
  # a region (ZONE_RESOURCE_POOL_EXHAUSTED) blocks the system node pool.
  [usc1]="e2-standard-4"
)

# ---------------------------------------------------------------------------
# Global load balancer
# ---------------------------------------------------------------------------
# How the regional pools are exposed behind one cross-region internal
# Application Load Balancer:
#   terraform   (default) the load balancer is managed by terraform/global_lb,
#               with GKE standalone NEGs from every region as backends, and
#               the llm-d router runs in Standalone Mode (Envoy + endpoint
#               picker) in each region.
#   mc-gateway  GKE multi-cluster Inference Gateway (fleet feature,
#               gke-l7-cross-regional-internal-managed-mc GatewayClass,
#               exported InferencePools). See the guide for its prerequisites.
export MR_GLOBAL_LB="${MR_GLOBAL_LB:-terraform}"
# Capacity of one region, in requests per second, for balancingMode RATE. The
# locality mode keeps traffic in the closest region up to this rate, then
# spills over. Calibrate it from a baseline run (the request rate where the
# region's TTFT SLO is still met).
# How the global load balancer measures a region's capacity, for spillover:
#   IN_FLIGHT  in-progress requests (default; suits LLM requests, which take
#              seconds to minutes)
#   RATE       new requests per second
export MR_LB_BALANCING_MODE="${MR_LB_BALANCING_MODE:-IN_FLIGHT}"
# Region capacity in in-progress requests (IN_FLIGHT), for --lb-mode locality
# and preferred, and for --lb-mode capacity (low, to spill over early).
# Plain vLLM with Qwen3-32B on one RTX PRO 6000 saturates at about 15-20
# in-progress requests per replica on the shared-prefix workload.
export MR_LB_REGION_CAPACITY_INFLIGHT="${MR_LB_REGION_CAPACITY_INFLIGHT:-32}"
export MR_LB_CAPACITY_MODE_INFLIGHT="${MR_LB_CAPACITY_MODE_INFLIGHT:-8}"
# Region capacity in requests per second (RATE).
export MR_LB_REGION_CAPACITY_QPS="${MR_LB_REGION_CAPACITY_QPS:-6}"
# Region capacity (requests per second) for --lb-mode capacity: low, so that
# traffic spills over to other regions early (see scripts/deploy-global-lb.sh).
export MR_LB_CAPACITY_MODE_QPS="${MR_LB_CAPACITY_MODE_QPS:-1}"

# ---------------------------------------------------------------------------
# Accelerator and model
# ---------------------------------------------------------------------------
# Both experiment arms (plain vLLM and llm-d) use the same accelerator, compute
# class, model, vLLM image, vLLM arguments, and replica count, so that only the
# deployment layer differs.
export MR_ACCELERATOR_TYPE="${MR_ACCELERATOR_TYPE:-rtx-pro-6000}"
export MR_COMPUTE_CLASS="${MR_COMPUTE_CLASS:-gpu-rtx-pro-6000-96gb-x1}"
# GPU machine type, for manifests/common/compute-class-gpu-obtainable.
export MR_GPU_MACHINE_TYPE="${MR_GPU_MACHINE_TYPE:-g4-standard-48}"
# Per-region GPU compute class, for regions where MR_COMPUTE_CLASS doesn't fit.
# "${MR_NAMESPACE}-gpu-obtainable" (manifests/common) starts with flex-start
# and Spot, which use preemptible quota. The default uses it in asia-southeast1,
# where the test project had no on-demand RTX PRO 6000 quota; check your
# project's quotas.
declare -gA MR_COMPUTE_CLASS_REGION=(
  [ase1]="${MR_NAMESPACE:-llm-mr}-gpu-obtainable"
)
export MR_GPU_COUNT="${MR_GPU_COUNT:-1}"
export MR_REPLICAS_PER_REGION="${MR_REPLICAS_PER_REGION:-2}"

# Horizontal Pod Autoscaler on the model servers of each region (both arms):
# MR_REPLICAS_PER_REGION is the minimum, MR_HPA_MAX_REPLICAS the maximum. It
# scales on the average number of requests waiting in the vLLM scheduler queue
# per pod (collected by GKE automatic application monitoring into Google Cloud
# Managed Service for Prometheus, served by the Custom Metrics Stackdriver
# Adapter that the core platform installs).
export MR_HPA_ENABLED="${MR_HPA_ENABLED:-true}"
export MR_HPA_MAX_REPLICAS="${MR_HPA_MAX_REPLICAS:-$((2 * MR_REPLICAS_PER_REGION))}"
export MR_HPA_METRIC="${MR_HPA_METRIC:-prometheus.googleapis.com|vllm:num_requests_waiting|gauge}"
export MR_HPA_TARGET_AVERAGE="${MR_HPA_TARGET_AVERAGE:-5}"
# Second HPA metric: requests running per pod. The queue metric alone drops to
# about 0 as soon as the added replicas absorb the load, and the HPA then
# scaled in while the load was still high (first scale-out test), which rebuilt the
# queue and cold-started replicas again. The HPA uses the larger of the two
# metrics' replica counts, so this one holds the replicas while they're busy.
# Qwen3-32B on RTX PRO 6000 (shared-prefix workload) ran 22-24 requests per
# pod at the edge of the SLO; set it for your model and traffic.
export MR_HPA_RUNNING_METRIC="${MR_HPA_RUNNING_METRIC:-prometheus.googleapis.com|vllm:num_requests_running|gauge}"
export MR_HPA_TARGET_RUNNING="${MR_HPA_TARGET_RUNNING:-25}"

# GKE Pod snapshots for the llm-d arm: the first model server pod of a region
# is checkpointed once vLLM is healthy, and every later pod (for example, the
# ones that the HPA adds) is restored from that snapshot instead of loading and
# compiling the model again. Needs `deploy-region.sh` with this set (snapshot
# bucket, IAM, cluster feature). Model servers then run in GKE Sandbox
# (gVisor). Use the optimized baseline router (`--backend ob`): a restored pod
# resumes the source pod's memory, including the KV events topic with the
# source pod's IP, so precise prefix cache routing would credit the restored
# pods' KV cache to the source pod.
export MR_POD_SNAPSHOTS_ENABLED="${MR_POD_SNAPSHOTS_ENABLED:-false}"
export MR_POD_SNAPSHOT_TIMEOUT_S="${MR_POD_SNAPSHOT_TIMEOUT_S:-2400}"
export MR_POD_SNAPSHOT_MEMORY_LIMIT="${MR_POD_SNAPSHOT_MEMORY_LIMIT:-140Gi}"

# Hugging Face model ID. The model is staged once per region in the regional
# Cloud Storage bucket created by the core platform, under the lowercase ID.
export MR_HF_MODEL_ID="${MR_HF_MODEL_ID:-Qwen/Qwen3-32B}"
export MR_MODEL_PATH="${MR_HF_MODEL_ID,,}"
# Name the model is served as. It must match the tokenizer model name configured
# for the llm-d precise prefix cache `token-producer` plugin.
export MR_SERVED_MODEL_NAME="${MR_SERVED_MODEL_NAME:-${MR_HF_MODEL_ID}}"
export MR_MAX_MODEL_LEN="${MR_MAX_MODEL_LEN:-32768}"
export MR_GPU_MEMORY_UTILIZATION="${MR_GPU_MEMORY_UTILIZATION:-0.90}"
export MR_TENSOR_PARALLEL_SIZE="${MR_TENSOR_PARALLEL_SIZE:-1}"

# Optional: an existing bucket that already contains "${MR_MODEL_PATH}". When
# set, models are copied from it instead of being downloaded from Hugging Face.
export MR_MODEL_SOURCE_BUCKET="${MR_MODEL_SOURCE_BUCKET:-}"

# Local file with a Hugging Face read token. It is added to the per-region
# Secret Manager secret created by the core platform, and is never written to
# the repository.
export MR_HF_TOKEN_FILE="${MR_HF_TOKEN_FILE:-${HOME}/hftoken}"

# ---------------------------------------------------------------------------
# Pinned versions (reproducibility)
# ---------------------------------------------------------------------------
# Every upstream llm-d artifact (Kustomize bases, router Helm values, chart, and
# images) is pinned. Never use a branch name such as "main" here: llm-d main
# changes resource kinds between releases (for example, the P/D guides moved
# from Deployment to DisaggregatedSet), which silently breaks overlays.
#
# llm-d v1.0.0 commit (https://github.com/llm-d/llm-d/releases/tag/v1.0.0).
# Use the commit SHA, not the annotated tag object SHA.
export MR_LLMD_GIT_REF="${MR_LLMD_GIT_REF:-378b42d18dabe0b9c4ced4e6f3670d93b52db08e}"
export MR_LLMD_ROUTER_CHART="${MR_LLMD_ROUTER_CHART:-oci://ghcr.io/llm-d/charts/llm-d-router-gateway}"
export MR_LLMD_ROUTER_CHART_VERSION="${MR_LLMD_ROUTER_CHART_VERSION:-v1.0.0}"
# Expected OCI digest of the router chart; verified before install.
export MR_LLMD_ROUTER_CHART_DIGEST="${MR_LLMD_ROUTER_CHART_DIGEST:-sha256:0a16af45be7457acea1d5df2a3e2b7da7583ad65efcb30a65bbd6f2fd8f6ea4e}"
# llm-d router endpoint picker (EPP) image tag, pinned by digest.
export MR_LLMD_EPP_IMAGE_TAG="${MR_LLMD_EPP_IMAGE_TAG:-v1.0.0@sha256:024188e998f516879f68532016ca24fabca00afbdcc2af9a61b17634e197df2c}"
# llm-d router chart used with the Terraform-managed global load balancer
# (MR_GLOBAL_LB=terraform): Standalone Mode, an Envoy proxy next to the endpoint
# picker in each region.
export MR_LLMD_ROUTER_STANDALONE_CHART="${MR_LLMD_ROUTER_STANDALONE_CHART:-oci://ghcr.io/llm-d/charts/llm-d-router-standalone}"
export MR_LLMD_ROUTER_STANDALONE_CHART_DIGEST="${MR_LLMD_ROUTER_STANDALONE_CHART_DIGEST:-sha256:c1d1af55382ef1097188d188070385c6de02b771f34681678e658a59e975024c}"
export MR_LLMD_ENVOY_IMAGE="${MR_LLMD_ENVOY_IMAGE:-docker.io/envoyproxy/envoy:distroless-v1.33.2@sha256:85500e28ed088ec39ff0adc1be3d358a8ad062926aaa62c36b28bde00919e4e8}"
# vLLM image used by BOTH experiment arms. llm-d v1.0.0 pins vLLM v0.31.0.
export MR_VLLM_IMAGE="${MR_VLLM_IMAGE:-docker.io/vllm/vllm-openai:v0.31.0@sha256:c1c9f6fd5c109ba7f0546a59f5b2f15fb87f64c77782e90a27b648b42a8e67c3}"
# Load generator image (https://github.com/kubernetes-sigs/inference-perf).
export MR_INFERENCE_PERF_IMAGE="${MR_INFERENCE_PERF_IMAGE:-quay.io/inference-perf/inference-perf:v0.7.0@sha256:d247e6ad725dc5bb56df71d115abc8ca455bba9f0ccd4110e14bbb56504250ec}"
# Placeholder that keeps the GPU nodes between arms (delete-arm.sh --hold-gpus).
export MR_GPU_HOLD_IMAGE="${MR_GPU_HOLD_IMAGE:-registry.k8s.io/pause:3.10@sha256:ee6521f290b2168b6e0935a181d4cff9be1ac3f505666ef0e3c98fae8199917a}"

# ---------------------------------------------------------------------------
# Local working directories
# ---------------------------------------------------------------------------
# Each region is deployed from its own Git worktree, because the core platform
# writes generated files (backend.tf, *.auto.tfvars, kubeconfig, manifests) into
# the checkout. One worktree per region lets regions deploy in parallel without
# interfering with each other.
export MR_WORK_DIR="${MR_WORK_DIR:-${HOME}/.acp-llmd-multi-region/${MR_PROJECT_ID}-${MR_RESOURCE_NAME_PREFIX}-${MR_ENVIRONMENT_NAME}}"
export MR_RESULTS_DIR="${MR_RESULTS_DIR:-${MR_WORK_DIR}/results}"

# ---------------------------------------------------------------------------
# Optional external front door (prototype, OFF by default)
# ---------------------------------------------------------------------------
# scripts/deploy-front-door.sh adds an IAP-protected global external HTTPS load
# balancer in front of the internal multi-cluster Inference Gateway, for demos.
# No other script deploys it; teardown-all.sh removes it if it exists. See
# manifests/front-door/README.md before enabling it.
#
# Namespace of the front door (Envoy relay, external Gateway, and policies) in
# the config cluster.
export MR_FRONT_DOOR_NAMESPACE="${MR_FRONT_DOOR_NAMESPACE:-${MR_NAMESPACE}-edge}"
# Base name of the front door's Google Cloud resources: "<name>-ip" (global
# address), "<name>-cert" (managed certificate), "<name>-ssl" (SSL policy), and
# "<name>-armor" (Cloud Armor policy).
export MR_FRONT_DOOR_NAME="${MR_FRONT_DOOR_NAME:-${MR_RESOURCE_NAME_PREFIX}-${MR_ENVIRONMENT_NAME}-llm-fd}"
# Host name, served by a DNS-only Cloud Endpoints service. It must have the
# form <name>.endpoints.<project_id>.cloud.goog. Set it explicitly for
# domain-scoped project IDs (with a ":").
export MR_FRONT_DOOR_HOSTNAME="${MR_FRONT_DOOR_HOSTNAME:-${MR_RESOURCE_NAME_PREFIX}-${MR_ENVIRONMENT_NAME}-llm.endpoints.${MR_PROJECT_ID}.cloud.goog}"
# Principals that may call the front door through IAP, separated by spaces or
# commas (user:, group:, serviceAccount:, domain:, principal://,
# principalSet://). Empty means only the account that runs the script
# (`gcloud config get-value account`). allUsers and allAuthenticatedUsers are
# always rejected.
export MR_FRONT_DOOR_IAP_MEMBERS="${MR_FRONT_DOOR_IAP_MEMBERS:-}"
# Where roles/iap.httpsResourceAccessor is granted:
#   backend-service  only on the front door's backend service (default),
#   project          on the project, which also grants access to every other
#                    IAP-secured web resource in the project.
export MR_FRONT_DOOR_IAP_SCOPE="${MR_FRONT_DOOR_IAP_SCOPE:-backend-service}"
# Optional custom OAuth client for IAP. When both are empty, IAP uses the
# Google-managed OAuth client (browser sign-in for users in the project's
# organization; programmatic access with service account credentials). The
# client secret is read from a local file and stored only in a Kubernetes
# Secret in MR_FRONT_DOOR_NAMESPACE.
export MR_IAP_OAUTH_CLIENT_ID="${MR_IAP_OAUTH_CLIENT_ID:-}"
export MR_IAP_OAUTH_CLIENT_SECRET_FILE="${MR_IAP_OAUTH_CLIENT_SECRET_FILE:-}"
# Optional Cloud Armor source IP allowlist, evaluated before IAP. When "true",
# MR_FRONT_DOOR_ALLOWED_CIDRS (CIDRs separated by spaces or commas) must not be
# empty.
export MR_FRONT_DOOR_CLOUD_ARMOR="${MR_FRONT_DOOR_CLOUD_ARMOR:-false}"
export MR_FRONT_DOOR_ALLOWED_CIDRS="${MR_FRONT_DOOR_ALLOWED_CIDRS:-}"
# Restrict the Envoy pods with a NetworkPolicy (ingress only from the load
# balancer, egress only to the internal Gateway VIP).
export MR_FRONT_DOOR_NETWORK_POLICY="${MR_FRONT_DOOR_NETWORK_POLICY:-true}"
# Load balancer backend timeout and Envoy route/idle timeouts, in seconds.
export MR_FRONT_DOOR_TIMEOUT_SEC="${MR_FRONT_DOOR_TIMEOUT_SEC:-3600}"
# How long to wait for the Google-managed certificate to become ACTIVE.
export MR_FRONT_DOOR_CERT_TIMEOUT_S="${MR_FRONT_DOOR_CERT_TIMEOUT_S:-3600}"
# Envoy image, pinned by digest (multi-arch index of distroless-v1.39.6).
export MR_FRONT_DOOR_ENVOY_IMAGE="${MR_FRONT_DOOR_ENVOY_IMAGE:-docker.io/envoyproxy/envoy:distroless-v1.39.6@sha256:1cac8b3a2f72d5a0918f54d7b49e68aae0b0ba325c2d50c8a9a3fff7a4d1f994}"
