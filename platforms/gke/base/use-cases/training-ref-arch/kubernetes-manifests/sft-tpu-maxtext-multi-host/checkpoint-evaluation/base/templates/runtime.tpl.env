CONTAINER_IMAGE_URL=us-docker.pkg.dev/cloud-tpu-images/maxtext-images/tpu_post_training:0.2.4
TRAINING_KUBERNETES_NAMESPACE=${sft_tpu_maxtext_multi_host_kubernetes_namespace_name}
TRAINING_KUBERNETES_SERVICE_ACCOUNT=${sft_tpu_maxtext_multi_host_kubernetes_service_account_name}
PATHWAYS_DIR=gs://${sft_tpu_maxtext_multi_host_dataset_bucket_name}/pathways
GCS_OUTPUT_PATH=gs://${sft_tpu_maxtext_multi_host_dataset_bucket_name}/pathways
MLFLOW_TRACKING_URI=http://mlflow-service-svc.${sft_cpu_mlflow_kubernetes_namespace_name}:5000
JAX_PLATFORMS=proxy
JAX_BACKEND_TARGET=grpc://127.0.0.1:29000
ENABLE_PATHWAYS_PERSISTENCE=1
