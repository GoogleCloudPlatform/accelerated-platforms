CONTAINER_IMAGE_URL=us-docker.pkg.dev/cloud-tpu-images/maxtext-images/tpu_post_training:0.2.4
TRAINING_KUBERNETES_NAMESPACE=${sft_tpu_maxtext_single_host_kubernetes_namespace_name}
TRAINING_KUBERNETES_SERVICE_ACCOUNT=${sft_tpu_maxtext_single_host_kubernetes_service_account_name}
MLFLOW_TRACKING_URI=http://mlflow-service-svc.${sft_cpu_mlflow_kubernetes_namespace_name}:5000
BASE_OUTPUT_DIRECTORY=gs://${sft_tpu_maxtext_single_host_dataset_bucket_name}/
HF_MODEL_NAME=${HF_MODEL_ID}
LOAD_PARAMETERS_PATH=gs://${huggingface_hub_models_bucket_name}/${HF_MODEL_ID}/0/items
RUN_NAME=${HF_MODEL_ID}-sft-v6e
USE_PATHWAYS=0
